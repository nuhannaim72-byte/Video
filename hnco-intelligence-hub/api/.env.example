# Copy to api/.env. Never commit real secrets; in Azure, use Key Vault references instead.

# development | production | test
ENVIRONMENT=development

# --- AI agents (leave empty to run the orchestrator in simulated mode) ---
OPENAI_API_KEY=
# Model for every agent; empty = the OpenAI Agents SDK default
OPENAI_MODEL=
EMBEDDING_MODEL=text-embedding-3-small

# --- Microsoft Entra ID ---
# dev = no sign-in (local only; refused when ENVIRONMENT=production)
AUTH_MODE=dev
ENTRA_TENANT_ID=
# JSON list of accepted token audiences, e.g. ["api://<api-app-client-id>","<api-app-client-id>"]
ENTRA_AUDIENCES=[]

# --- Data ---
# Empty = in-memory store. Example: postgresql+asyncpg://user:password@host:5432/hnco
DATABASE_URL=

# --- Artefact storage (Azure Blob) ---
# Either a connection string, or an account URL used with managed identity (preferred in Azure).
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=hnco-artifacts

# --- Office behaviour ---
AMBIENT_PRESENCE=true
SIMULATED_PACE=1.0
CORS_ORIGINS=["http://localhost:3000"]

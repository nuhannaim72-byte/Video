# Copy to web/.env.local.

# Server-side only: where the /api/hub proxy forwards to. Empty = no backend (in-browser simulation).
HNCO_API_URL=http://localhost:8000

# Microsoft Entra ID sign-in (public identifiers, inlined into the browser bundle — not secrets).
# Leave empty to run without sign-in (backend must then use AUTH_MODE=dev).
NEXT_PUBLIC_ENTRA_CLIENT_ID=
NEXT_PUBLIC_ENTRA_TENANT_ID=
# Scope exposed by the API app registration, e.g. api://<api-app-client-id>/Hub.Access
NEXT_PUBLIC_ENTRA_API_SCOPE=
